function plot_sigmoid_from_coeffs(a,b,c,plot_both)

a = transf(a);
b = transf(b);
c = transf(c);
x = [1; 2; 3; 4];
figure
if plot_both
nexttile
plot(x, test_2(x, b, c))
title("2 param sigmoid")
end

nexttile
plot(x, test_3(x, a, b, c))
title("3 param sigmoid")


nexttile
plot(x, test_3(x, a, b, c))
title("4 param sigmoid d=-5")


nexttile
plot(x, test_3(x, a, b, c))
title("3 param sigmoid d=-2")


nexttile
plot(x, test_3(x, a, b, c))
title("3 param sigmoid d=2")

nexttile
plot(x, test_3(x, a, b, c))
title("3 param sigmoid d)

end

function a = transf(a)
a=exp(abs(a));
end

function y = test_2(x, b, c)
y = 1/(1+b*exp(-c*(x)));
end

function y = test_3(x, a, b, c)
y = a/(1+b*exp(-c*(x)));
end

function y = test_4(x, a, b, c,d)
y = a/(1+b*exp(-c*(x-d)));
end