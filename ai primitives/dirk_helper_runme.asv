%load("subset_dirk_space.mat")

save_to = "C:\Users\lrako\OneDrive\Documents\human dm\ai primitives\06_10_04";
mkdir(save_to)
num_clusters = 12;
colors = distinguishable_colors(num_clusters);
[dirk_cluster_data, param_data, index] = clusters_to_configs(myTable, param_table, rand_rows, num_clusters ,colors,'euclidean',save_to);
savefig(save_to + "\dirk_clustering_" + string(num_clusters) + ".fig")
%close all 

%%
max_strio = 20;
max_da = 4;
max_lh = 15;

param_data.cluster = index;

mean_params = [];
figure(1)
figure(2)
figure(3)
for c = 1:num_clusters
    cluster_table = param_data(param_data.cluster == c, :);

    for i = 1:height(cluster_table)

        row = cluster_table(i,:);
        strio = row.strio;
        da = row.da;
        lh = row.lh;

        scatter3(strio, da, lh)
    end

    xlabel('strio hz')
    y
    title("config for cluster " + string(c))
    hold on
    
end

figure(1)
sgtitle("normalized mean + serr for configs")

figure(2)
sgtitle("range for configs")

figure(3)
sgtitle("variance for configs")

saveas(figure(1),save_to + "\configs_cluster_mean_" + string(num_clusters) + ".fig")
saveas(figure(2),save_to + "\configs_cluster_range_" + string(num_clusters) + ".fig")
saveas(figure(3),save_to + "\configs_cluster_var_" + string(num_clusters) + ".fig")

set(gcf,'renderer','Painters')