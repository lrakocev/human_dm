function color_raw_feats_by_cluster(feat_table)

feat_table = feat_table(~isnan(feat_table.cluster_number), :);
clusters = unique(feat_table.cluster_number);
colors = distinguishable_colors(length(clusters));

hs = [];
for i = 1:height(clusters)
    cluster = clusters(i);
    col = colors(i,:);
    cluster_table = feat_table(feat_table.cluster_number == cluster, :);

    x = cluster_table.med_appr;
    y = cluster_table.c_interact;
    z = cluster_table.med_appr;

    h =  scatter3(x,y,z,[],col);
    hs = [hs; h];
    hold on
end

xlabel('med appr')
ylabel('')
legend(hs)
hold off
end